// ril.pest

WHITESPACE = _{ " " | "\t" }

// A full pipeline: stage | stage | stage
pipeline = { stage ~ ("|" ~ stage)* }

// A stage is either a builtin command or a script path
stage = _{ builtin | script }

// Known builtin names
builtin = _{ load | save | tee }
load    = { "load" ~ path }
save    = { "save" ~ path }
tee     = { "tee" ~ path }

// A script: path to a .py file or binary, optional worker spec, plus optional flags
script      = { path ~ worker_spec? ~ flag* }
path        = @{ (ASCII_ALPHANUMERIC | "." | "/" | "_" | "-")+ }
worker_spec = @{ "x" ~ (ASCII_DIGIT+ | "D") }
flag    = { "--" ~ ident ~ "=" ~ value }

// Primitives
string  = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
expr    = { "'" ~ (!"'" ~ ANY)* ~ "'" }
ident   = { ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
value   = { string | number | ident }
number  = { ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
